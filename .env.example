# Placeholders only. Never commit real values. Never put service-role or secret keys in frontend code.
# Copy this file to .env.local and fill in the values from Supabase -> Project Settings -> API.

# Required. The Supabase project URL for "Maish Invoice & Quotation Manager".
VITE_SUPABASE_URL=https://bixuqaihfofrniuvwpfn.supabase.co

# Required. Public/publishable key only (anon key / publishable key). RLS protects the data.
# VITE_SUPABASE_PUBLISHABLE_KEY is the preferred name; VITE_SUPABASE_ANON_KEY is accepted too.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional. Set to "mock" to force the browser-only mock repository in local development.
# Without Supabase config AND without this flag, the app refuses to start (no silent mock fallback).
# VITE_DATA_MODE=mock
